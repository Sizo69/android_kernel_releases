[
  {
    "kernelSource": {
      "name": "RK-Xvyra",
      "repo": "https://github.com/YamazakuraH/marisa_kernel_xiaomi_sm8150_q.git",
      "branch": "master",
      "device": "cepheus",
      "defconfig": "cepheus_defconfig"
    },
    "withKernelSU": false,
    "toolchains": [
      {
        "repo": "https://android.googlesource.com/platform/prebuilts/clang/host/linux-x86/+archive/02d6b60f07ed970b2ac2fd61988a0204d3f141f5/clang-r530567.tar.gz",
        "branch": "main",
        "name": "clang",
        "binPath": ["bin"]
      },
      {
        "repo": "https://android.googlesource.com/platform/prebuilts/gcc/linux-x86/aarch64/aarch64-linux-android-4.9",
        "branch": "android12-release",
        "name": "gcc",
        "binPath": ["bin"]
      }
    ],
    "ccache": true,
    "params": {
      "ARCH": "arm64",
      "CC": "clang/bin/clang",
      "externalCommand": {
        "LLVM": "1",
        "CLANG_TRIPLE": "aarch64-linux-gnu-",
        "CROSS_COMPILE": "aarch64-linux-android-",
        "CROSS_COMPILE_ARM32": "arm-linux-androideabi-",
        "CROSS_COMPILE_COMPAT": "arm-linux-androideabi-"
      }
    },
    "AnyKernel3": {
      "use": true,
      "release": true,
      "repo": "https://github.com/Sizo69/AnyKernel3_alioth.git",
      "branch": "master"
    }
  }
]
