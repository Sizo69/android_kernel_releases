[
  {
    "kernelSource": {
      "name": "Anymore-Xvyra",
      "repo": "https://github.com/Anything-at-25-00/android_kernel_common_android12-5.10.git",
      "branch": "mahiru-primrose-nt-lts",
      "device": "gki",
      "defconfig": "gki_defconfig"
    },
    "withKernelSU": false,
    "toolchains": [
      {
        "repo": "https://gitlab.com/rvproject27/RvClang.git",
        "branch": "main/21.x",
        "name": "clang",
        "binPath": ["bin"]
      },
      {
        "repo": "https://android.googlesource.com/platform/prebuilts/gcc/linux-x86/aarch64/aarch64-linux-android-4.9",
        "branch": "android12-release",
        "name": "gcc",
        "binPath": ["bin"]
      }
    ],
    "ccache": true,
    "params": {
      "ARCH": "arm64",
      "CC": "clang/bin/clang",
      "externalCommand": {
        "LLVM": "1",
        "CLANG_TRIPLE": "aarch64-linux-gnu-",
        "CROSS_COMPILE": "aarch64-linux-android-",
        "CROSS_COMPILE_ARM32": "arm-linux-androideabi-",
        "CROSS_COMPILE_COMPAT": "arm-linux-androideabi-"
      }
    },
    "AnyKernel3": {
      "use": true,
      "release": true,
      "repo": "https://github.com/Anything-at-25-00/AnyKernel3.git",
      "branch": "mahiru5.10"
    }
  }
]
